# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# URL base de la UI y de la API bajo prueba
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Cuenta de administrador (ver "Default accounts" en el README de Toolshop)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Navegador: chrome | chromium | edge | electron | firefox | webkit
BROWSER=chrome
